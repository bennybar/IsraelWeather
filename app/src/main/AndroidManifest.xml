<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The user chooses precise or approximate; either finds the nearest of IMS's 175 forecast points. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- "Allow all the time": widgets and background refresh follow the user. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".WeatherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.IsraelWeather">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A widget's own settings (long-press → Widget settings). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>

        <receiver android:name=".widget.HourlyWidgetReceiver" android:exported="true" android:label="@string/widget_hourly">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hourly" />
        </receiver>
        <receiver android:name=".widget.DailyWidgetReceiver" android:exported="true" android:label="@string/widget_daily">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily" />
        </receiver>
        <receiver android:name=".widget.HourlyTableReceiver" android:exported="true" android:label="@string/widget_hourly_table">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hourly_table" />
        </receiver>
        <receiver android:name=".widget.DailyTableReceiver" android:exported="true" android:label="@string/widget_daily_table">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily_table" />
        </receiver>
        <receiver android:name=".widget.HourlyTonalReceiver" android:exported="true" android:label="@string/widget_hourly_tonal">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hourly_tonal" />
        </receiver>
        <receiver android:name=".widget.DailyTonalReceiver" android:exported="true" android:label="@string/widget_daily_tonal">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily_tonal" />
        </receiver>
        <receiver android:name=".widget.QuietWeekReceiver" android:exported="true" android:label="@string/widget_quiet">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quiet" />
        </receiver>
        <receiver android:name=".widget.RangesReceiver" android:exported="true" android:label="@string/widget_ranges">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ranges" />
        </receiver>
        <receiver android:name=".widget.ClassicComboReceiver" android:exported="true" android:label="@string/widget_combo">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_combo" />
        </receiver>
        <receiver android:name=".widget.TableComboReceiver" android:exported="true" android:label="@string/widget_combo_table">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_combo_table" />
        </receiver>
        <receiver android:name=".widget.SoftComboReceiver" android:exported="true" android:label="@string/widget_combo_tonal">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_combo_tonal" />
        </receiver>
        <receiver android:name=".widget.StripWidgetReceiver" android:exported="true" android:label="@string/widget_strip">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_strip" />
        </receiver>
        <receiver android:name=".widget.AlertsWidgetReceiver" android:exported="true" android:label="@string/widget_alerts">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_alerts" />
        </receiver>
    </application>

</manifest>
